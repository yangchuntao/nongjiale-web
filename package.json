{
  "name": "nongjiale-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev:portal": "pnpm --filter portal dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:merchant": "pnpm --filter merchant dev",
    "build": "pnpm -r build",
