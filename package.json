{
  "name": "nongjiale-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:portal": "pnpm --filter @nongjiale/portal dev",
    "dev:admin": "pnpm --filter @nongjiale/admin dev",
    "dev:merchant": "pnpm --filter @nongjiale/merchant dev",
    "build": "pnpm --filter @nongjiale/portal --filter @nongjiale/admin --filter @nongjiale/merchant build",
    "build:portal": "pnpm --filter @nongjiale/portal build",
    "build:admin": "pnpm --filter @nongjiale/admin build",
    "build:merchant": "pnpm --filter @nongjiale/merchant build",
    "typecheck": "pnpm --filter @nongjiale/shared --filter @nongjiale/portal --filter @nongjiale/admin --filter @nongjiale/merchant typecheck",
    "test": "pnpm --filter @nongjiale/shared --filter @nongjiale/portal --filter @nongjiale/admin --filter @nongjiale/merchant test"
  }
}
