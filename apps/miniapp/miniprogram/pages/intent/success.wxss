.center {
  text-align: center;
}

.mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  font-size: 48rpx;
  line-height: 96rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.no {
  margin-top: 16rpx;
  font-family: ui-monospace, monospace;
}

.copy {
  margin-top: 16rpx;
}
