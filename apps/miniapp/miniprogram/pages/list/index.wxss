.search {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-btn {
  width: 160rpx;
  flex: none;
}

.thumb {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: #e7eef4;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.hint,
.more {
  margin-top: 12rpx;
}

.retry {
  margin-top: 24rpx;
}
