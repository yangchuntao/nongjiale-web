<view class="page" style="--color-brand: {{brandColor}}; --color-on-brand: {{onBrand}};">
  <view class="card filter">
    <scroll-view class="chip-scroll" scroll-x enable-flex>
      <view class="chip {{regionId === 0 ? 'on' : ''}}" data-id="0" bindtap="onCity">全部已开通市</view>
      <view
        class="chip {{regionId === item.id ? 'on' : ''}}"
        wx:for="{{cities}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCity"
      >{{item.name}}</view>
    </scroll-view>
    <view class="search">
      <input
        class="input"
        placeholder="店名/关键词"
        value="{{draftKeyword}}"
        maxlength="64"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <button class="btn search-btn" bindtap="onSearch">搜索</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="skeleton"></view>
  <view wx:elif="{{error}}" class="empty">
    <view>列表加载失败，请重试</view>
    <button class="btn retry" bindtap="onRetry">重试</button>
  </view>
  <view wx:elif="{{closed}}" class="empty">{{closedHint}}</view>
  <view wx:elif="{{stores.length === 0}}" class="empty">
    <view>{{emptyText}}</view>
    <view class="muted hint">换一个已开通的城市，或改一下关键词</view>
  </view>
  <block wx:else>
    <view class="card store" wx:for="{{stores}}" wx:key="id" data-id="{{item.id}}" bindtap="onStore">
      <image wx:if="{{item.coverUrl}}" class="thumb" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="name">{{item.name}}</view>
      <view class="muted">{{item.regionName}}</view>
      <view wx:if="{{item.price}}">{{item.price}}</view>
      <view>
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="muted more">加载中</view>
  </block>
</view>
