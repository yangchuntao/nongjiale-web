<view class="page" style="--color-brand: {{brandColor}}; --color-on-brand: {{onBrand}};">
  <view wx:if="{{loading}}" class="skeleton"></view>
  <view wx:elif="{{error}}" class="empty">
    <view>{{error}}</view>
    <button class="btn retry" bindtap="onRetry">重试</button>
  </view>
  <block wx:else>
    <view class="notice">未锁房，以客服确认为准</view>
    <view class="card">
      <view class="row">
        <view class="no">{{intentNo}}</view>
        <text class="tag">{{statusText}}</text>
      </view>
      <view class="name">{{storeName}}</view>
      <view class="line">到店 {{checkIn}}</view>
      <view wx:if="{{checkOut}}" class="line">离店 {{checkOut}}</view>
      <view wx:if="{{nights}}" class="line">晚数 {{nights}}</view>
      <view wx:if="{{guests}}" class="line">人数 {{guests}}</view>
      <view class="line">联系人 {{contactName}}</view>
      <view class="line">手机 {{contactPhone}}</view>
      <view wx:if="{{userRemark}}" class="line">备注 {{userRemark}}</view>
      <view class="muted">{{createdAt}}</view>
    </view>
    <view class="stack">
      <button class="btn-ghost" bindtap="onBack">返回</button>
      <button wx:if="{{servicePhone}}" class="btn" bindtap="onCall">拨打客服</button>
    </view>
  </block>
</view>
